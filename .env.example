# Copy to .env.local (ignored by Git) and fill in the one you use. Never commit a real key.
# OPENAI_API_KEY=
# SHOTSPEAK_OPENAI_MODEL=gpt-image-2.5-flare

# Higgsfield: KEY_ID:KEY_SECRET. The image route is not verified with a live request.
# HF_KEY=
# SHOTSPEAK_HIGGSFIELD_MODEL=marketing-studio/image/flare

# FAL_KEY=
# SHOTSPEAK_FAL_MODEL=

# REPLICATE_API_TOKEN=
# SHOTSPEAK_REPLICATE_MODEL=

# Limits
# SHOTSPEAK_MAX_IMAGES=4
# SHOTSPEAK_MAX_USD=1.00
# SHOTSPEAK_MAX_ROUNDS=3
# SHOTSPEAK_EST_USD_PER_IMAGE=0.07

# Blocking previs (optional)
# BLENDER=/path/to/blender
# SHOTSPEAK_BLENDER_MCP_HOST=localhost
# SHOTSPEAK_BLENDER_MCP_PORT=9876
